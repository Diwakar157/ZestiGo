# ──────────────────────────────────────────────
# ZestiGo Monorepo — Production Environment Variables template
# ──────────────────────────────────────────────

# ==============================================================================
# ☕ BACKEND (Spring Boot) - Deploying to Render
# ==============================================================================
BACKEND_PORT=8080
BACKEND_SPRING_PROFILES_ACTIVE=prod

# Database (Neon PostgreSQL)
# Format: jdbc:postgresql://<neon-host>:<port>/neondb?sslmode=require
BACKEND_DB_URL=jdbc:postgresql://ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
BACKEND_DB_USERNAME=your_neon_username
BACKEND_DB_PASSWORD=your_neon_password

# JWT secret (Base64 encoded). Generate with: openssl rand -base64 64
BACKEND_JWT_SECRET=

# Clerk Authentication
BACKEND_CLERK_PUBLISHABLE_KEY=pk_test_...
BACKEND_CLERK_SECRET_KEY=sk_test_...
BACKEND_CLERK_ISSUER_URL=https://your-clerk-instance.clerk.accounts.dev

# Razorpay Integration
BACKEND_RAZORPAY_KEY_ID=rzp_test_...
BACKEND_RAZORPAY_KEY_SECRET=your_razorpay_key_secret
BACKEND_RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Allowed CORS origins
BACKEND_FRONTEND_URL=https://zestigo-frontend.vercel.app
BACKEND_ADMIN_URL=https://zestigo-admin.vercel.app

# Google OAuth2 credentials
BACKEND_GOOGLE_CLIENT_ID=your_google_client_id
BACKEND_GOOGLE_CLIENT_SECRET=your_google_client_secret


# ==============================================================================
# ⚛️ FRONTEND (Vite React) - Deploying to Vercel
# ==============================================================================
FRONTEND_VITE_API_URL=https://zestigo-backend.onrender.com
FRONTEND_VITE_CLERK_PUBLISHABLE_KEY=pk_test_...


# ==============================================================================
# 🛠️ ADMIN DASHBOARD (Next.js Prisma) - Deploying to Vercel
# ==============================================================================
# Database (Prisma PostgreSQL URL)
# Format: postgresql://<username>:<password>@<neon-host>:<port>/neondb?sslmode=require
ADMIN_DATABASE_URL=postgresql://your_neon_username:your_neon_password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# API configurations
ADMIN_VITE_ADMIN_API_URL=https://zestigo-backend.onrender.com
ADMIN_VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk Auth (Next.js automatically uses these)
ADMIN_NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
ADMIN_CLERK_SECRET_KEY=sk_test_...
ADMIN_NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
ADMIN_NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin/dashboard

# Access Control
ADMIN_EMAIL=admin@zestigo.com
