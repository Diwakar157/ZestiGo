// Zestigo Admin Dashboard — Prisma Schema
// Maps to the existing zestigo_db PostgreSQL database used by the Spring Boot backend.
// Uses @@map() and @map() to match existing snake_case table/column names.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  ROLE_USER
  ROLE_ADMIN
  ROLE_DELIVERY
}

enum AuthProvider {
  LOCAL
  GOOGLE
  CLERK
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentMethod {
  RAZORPAY
  WALLET
  COD
  CARD
  UPI
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum VehicleType {
  BIKE
  SCOOTER
  BICYCLE
  CAR
}

// ─── Models ──────────────────────────────────────────────

model User {
  id         String       @id @db.VarChar(36)
  name       String       @db.VarChar(100)
  email      String       @unique @db.VarChar(100)
  password   String?      @db.VarChar(255)
  phone      String?      @db.VarChar(20)
  avatar     String?      @db.VarChar(255)
  role       Role         @default(ROLE_USER)
  provider   AuthProvider @default(LOCAL)
  providerId String?      @map("provider_id") @db.VarChar(255)
  isBlocked  Boolean      @default(false) @map("is_blocked")
  createdAt  DateTime?    @default(now()) @map("created_at")
  updatedAt  DateTime?    @updatedAt @map("updated_at")

  addresses       Address[]
  cart            Cart?
  orders          Order[]
  reviews         Review[]
  wishlists       Wishlist[]
  deliveryPartner DeliveryPartner?

  @@map("users")
}

model Address {
  id        String   @id @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  label     String   @db.VarChar(50)
  line      String   @db.Text
  isDefault Boolean  @default(false) @map("is_default")
  latitude  Float?
  longitude Float?
  placeId   String?  @map("place_id") @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Restaurant {
  id           String           @id @db.VarChar(36)
  name         String           @db.VarChar(100)
  cuisine      String           @db.VarChar(255)
  rating       Decimal          @default(0.00) @db.Decimal(3, 2)
  reviewsCount Int              @default(0) @map("reviews_count")
  deliveryTime Int              @map("delivery_time")
  deliveryFee  Decimal          @map("delivery_fee") @db.Decimal(10, 2)
  distance     Decimal          @db.Decimal(5, 2)
  priceRange   String           @map("price_range") @db.VarChar(5)
  imageUrl     String?          @map("image_url") @db.VarChar(255)
  bannerUrl    String?          @map("banner_url") @db.VarChar(255)
  address      String           @db.Text
  promoted     Boolean?         @default(false)
  description  String?          @db.Text
  status       RestaurantStatus @default(ACTIVE)
  createdAt    DateTime?        @default(now()) @map("created_at")
  updatedAt    DateTime?        @updatedAt @map("updated_at")

  categories RestaurantCategory[]
  foodItems  FoodItem[]
  orders     Order[]
  reviews    Review[]

  @@map("restaurants")
}

model FoodCategory {
  id       String  @id @db.VarChar(36)
  name     String  @unique @db.VarChar(50)
  icon     String? @db.VarChar(10)
  imageUrl String? @map("image_url") @db.VarChar(255)

  restaurants RestaurantCategory[]

  @@map("food_categories")
}

model RestaurantCategory {
  restaurantId String @map("restaurant_id") @db.VarChar(36)
  categoryId   String @map("category_id") @db.VarChar(36)

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   FoodCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([restaurantId, categoryId])
  @@map("restaurant_categories")
}

model FoodItem {
  id           String  @id @db.VarChar(36)
  restaurantId String  @map("restaurant_id") @db.VarChar(36)
  name         String  @db.VarChar(100)
  description  String? @db.Text
  price        Decimal @db.Decimal(10, 2)
  imageUrl     String? @map("image_url") @db.VarChar(255)
  category     String  @db.VarChar(50)
  rating       Decimal @default(0.00) @db.Decimal(3, 2)
  reviewsCount Int     @default(0) @map("reviews_count")
  popular      Boolean @default(false)
  veg          Boolean @default(true)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]
  reviews    Review[]

  @@map("food_items")
}

model Cart {
  id        String    @id @db.VarChar(36)
  userId    String    @unique @map("user_id") @db.VarChar(36)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("cart")
}

model CartItem {
  id         String @id @db.VarChar(36)
  cartId     String @map("cart_id") @db.VarChar(36)
  foodItemId String @map("food_item_id") @db.VarChar(36)
  quantity   Int

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@unique([cartId, foodItemId])
  @@map("cart_items")
}

model Coupon {
  code        String  @id @db.VarChar(20)
  description String  @db.VarChar(255)
  type        String  @db.VarChar(10)
  value       Decimal @db.Decimal(10, 2)
  minOrder    Decimal @map("min_order") @db.Decimal(10, 2)
  active      Boolean @default(true)

  @@map("coupons")
}

model Order {
  id             String      @id @db.VarChar(36)
  userId         String      @map("user_id") @db.VarChar(36)
  restaurantId   String      @map("restaurant_id") @db.VarChar(36)
  restaurantName String      @map("restaurant_name") @db.VarChar(100)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(10, 2)
  status         OrderStatus @default(PENDING_PAYMENT)
  address        String      @db.Text
  createdAt      DateTime?   @default(now()) @map("created_at")
  updatedAt      DateTime?   @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id])
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  items      OrderItem[]
  payment    Payment?

  @@map("orders")
}

model OrderItem {
  id              String  @id @db.VarChar(36)
  orderId         String  @map("order_id") @db.VarChar(36)
  foodItemId      String  @map("food_item_id") @db.VarChar(36)
  quantity        Int
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(10, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItem FoodItem @relation(fields: [foodItemId], references: [id])

  @@map("order_items")
}

model Payment {
  id                String        @id @db.VarChar(36)
  orderId           String        @unique @map("order_id") @db.VarChar(36)
  razorpayOrderId   String?       @unique @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId String?       @unique @map("razorpay_payment_id") @db.VarChar(100)
  razorpaySignature String?       @map("razorpay_signature") @db.VarChar(255)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR") @db.VarChar(10)
  paymentMethod     PaymentMethod @map("payment_method")
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  refundStatus      String?       @default("NOT_REFUNDED") @map("refund_status") @db.VarChar(50)
  transactionTime   DateTime?     @map("transaction_time")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime?     @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id           String   @id @db.VarChar(36)
  userId       String   @map("user_id") @db.VarChar(36)
  restaurantId String?  @map("restaurant_id") @db.VarChar(36)
  foodItemId   String?  @map("food_item_id") @db.VarChar(36)
  rating       Int
  comment      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  foodItem   FoodItem?   @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Wishlist {
  id        String   @id @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  itemId    String   @map("item_id") @db.VarChar(36)
  type      String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId, type], map: "uk_wishlist_user_item_type")
  @@map("wishlist")
}

model DeliveryPartner {
  id          String      @id @default(uuid()) @db.VarChar(36)
  userId      String      @unique @map("user_id") @db.VarChar(36)
  vehicleType VehicleType @default(BIKE) @map("vehicle_type")
  isAvailable Boolean     @default(true) @map("is_available")
  earnings    Decimal     @default(0.00) @db.Decimal(10, 2)
  currentLat  Float?      @map("current_lat")
  currentLng  Float?      @map("current_lng")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("delivery_partners")
}
