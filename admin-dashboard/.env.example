# ──────────────────────────────────────────────
# ZestiGo Admin Dashboard — Production Environment Variables
# Copy this file to .env.local and fill in real values.
# ──────────────────────────────────────────────

# Database Connection (Prisma)
# DATABASE_URL format: postgresql://<username>:<password>@<neon-host>:<port>/neondb?sslmode=require
DATABASE_URL=postgresql://your_neon_username:your_neon_password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Frontend API configurations (as requested)
VITE_ADMIN_API_URL=https://zestigo-backend.onrender.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Next.js Clerk Authentication (automatically used by @clerk/nextjs)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin/dashboard

# Access Control
ADMIN_EMAIL=admin@zestigo.com
