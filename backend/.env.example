# ──────────────────────────────────────────────
# ZestiGo Backend — Environment Variables
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────

# Server port (Render injects this automatically)
PORT=8080

# Spring profile (prod / dev)
SPRING_PROFILE=prod

# Database (PostgreSQL JDBC URL)
DB_URL=jdbc:postgresql://localhost:5432/zestigo_db
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# JPA settings (override for dev: DDL_AUTO=update, SHOW_SQL=true)
DDL_AUTO=update
SHOW_SQL=false

# SQL init mode — set to "always" only for first-time seeding, then switch to "never"
SQL_INIT_MODE=never

# JWT signing secret (Base64-encoded, 256-bit minimum)
JWT_SECRET=your_base64_encoded_jwt_secret

# Clerk authentication
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER_URL=https://your-app.clerk.accounts.dev

# Razorpay payments
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Google OAuth2 (for social login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# CORS & redirect URLs
FRONTEND_URL=http://localhost:8080
ADMIN_URL=http://localhost:3001
