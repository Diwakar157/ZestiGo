# ──────────────────────────────────────────────
# ZestiGo Backend — Production Environment Variables
# Copy this file to .env and fill in real values.
# ──────────────────────────────────────────────

# Server configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database connection (Neon PostgreSQL)
# DB_URL format: jdbc:postgresql://<neon-host>:<port>/neondb?sslmode=require
DB_URL=jdbc:postgresql://ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=your_neon_username
DB_PASSWORD=your_neon_password

# JWT signing secret (Base64 encoded, minimum 256 bits for HS256). Generate with: openssl rand -base64 64
JWT_SECRET=

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER_URL=https://your-clerk-instance.clerk.accounts.dev

# Razorpay Integration
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Allowed CORS origins
FRONTEND_URL=https://zestigo-frontend.vercel.app
ADMIN_URL=https://zestigo-admin.vercel.app

# Google OAuth2 credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
